{
	"name": "barchy",
	"version": "0.1.0",
	"private": true,
	"description": "Offline-first vademecum voor architectuur- en bouwkundestudenten",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"icons": "pwa-assets-generator"
	},
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@lucide/svelte": "1.61.0",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "6.2.4",
		"@types/node": "22.20.5",
		"@vite-pwa/assets-generator": "1.0.4",
		"@vite-pwa/sveltekit": "1.1.0",
		"eslint": "9.39.5",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"typescript": "5.9.3",
		"typescript-eslint": "8.72.0",
		"vite": "7.3.7",
		"vitest": "4.1.12",
		"zod": "4.6.7"
	},
	"dependencies": {
		"idb-keyval": "6.3.0"
	}
}
