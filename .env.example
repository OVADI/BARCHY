# Base path for a GitHub Pages project site (e.g. /BARCHY). Leave empty for the custom domain.
BASE_PATH=
# Repository URL; enables the "Fout gevonden" and "Ik zocht iets" links.
VITE_REPO_URL=
# Web3Forms access key for the feedback form on About. Without it, About links to GitHub issues.
VITE_WEB3FORMS_KEY=
